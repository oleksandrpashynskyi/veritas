# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# downloaded library source (read-only reference, populated via opensrc)
/repos/

# typescript
*.tsbuildinfo
next-env.d.ts

# veritas-security-proof — transient build probe (written then removed by the skill;
# ignored so a crashed run can never accidentally commit it)
/src/app/security-probe/
