# Copy to .env.local and fill in. .env.local is gitignored; this file is committed.
#
# Two access paths as of M2:
#  - The app's USER-DATA path uses a PER-USER client (publishable anon key + the logged-in
#    user's session) so RLS enforces per-user ownership — the NEXT_PUBLIC_* vars below.
#  - The service-role key (bypasses RLS) is server-only and is NOT used in the app's user-data
#    path; it remains for admin/verification use. Never expose it to the browser.
# RLS is deny-by-default for anon and per-user for authenticated on every table.

# Supabase API endpoint — the project API URL, NOT the dashboard URL.
#   Correct:   https://<project-ref>.supabase.co
#   Wrong:     https://supabase.com/dashboard/project/<project-ref>
# Hosted: Dashboard -> Settings -> API -> "Project URL".
# Local (after Docker + `npx supabase start`): http://127.0.0.1:54321
SUPABASE_URL=

# Service-role key — Dashboard -> Settings -> API -> "service_role" secret.
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Publishable anon key — Dashboard -> Settings -> API -> "anon" "public".
# Also used by the veritas-security-proof skill (connects AS anon to prove RLS denies it).
# Public by design, but still kept out of git like the others.
SUPABASE_ANON_KEY=

# Per-user app clients (@supabase/ssr) — browser + server. NEXT_PUBLIC_* reaches the browser
# bundle, so use the PUBLISHABLE anon key here, never the service-role key. Point at the stack
# the app should talk to (local: http://127.0.0.1:54321 + the local anon key from
# `npx supabase status`).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic — unused until M3 (job-requirement extraction).
ANTHROPIC_API_KEY=
