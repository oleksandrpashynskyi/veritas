# Copy to .env.local and fill in. .env.local is gitignored; this file is committed.
# All Supabase access is server-side with the service-role key (single-user). The
# key bypasses RLS, while RLS is enabled deny-by-default on every table so the
# public anon/authenticated API roles cannot touch career data. These vars are
# NOT prefixed NEXT_PUBLIC_ and never reach the browser bundle.

# Supabase API endpoint — the project API URL, NOT the dashboard URL.
#   Correct:   https://<project-ref>.supabase.co
#   Wrong:     https://supabase.com/dashboard/project/<project-ref>
# Hosted: Dashboard -> Settings -> API -> "Project URL".
# Local (after Docker + `npx supabase start`): http://127.0.0.1:54321
SUPABASE_URL=

# Service-role key — Dashboard -> Settings -> API -> "service_role" secret.
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Publishable anon key — Dashboard -> Settings -> API -> "anon" "public".
# NOT used by the app (all app access is the service-role client). Used ONLY by the
# veritas-security-proof skill, which connects AS the public anon role to prove RLS
# denies it every row. Public by design, but still kept out of git like the others.
SUPABASE_ANON_KEY=

# Anthropic — unused until M3 (job-requirement extraction).
ANTHROPIC_API_KEY=
